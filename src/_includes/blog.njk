---
layout: base
css:
  - /css/cards.css
permalink: /
---
{% from "card.njk" import card %}
<div class="justify-center flex-column">
{%- for a in collections.article | reverse -%}
  {%- if a.url.startsWith('/' + page.lang) and not a.data.ignore -%}
  {{ card(a, page.lang, true, "article") }}
  {%- endif %}
{%- endfor -%}
</div>
