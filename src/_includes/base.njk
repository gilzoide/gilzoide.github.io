---
css: []
nav_items:
  - ["/", "Work"]
  - ["/about/", "About"]
---
<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-witdh, initial-scale=1" />
    <title>{% if title %}{{ title }} - {% endif %}gilzoide</title>
    <link rel="stylesheet" href="/css/base.css" />
    {%- for css_url in css %}
    <link rel="stylesheet" href="{{ css_url }}" />
    {% endfor -%}
  </head>
  <body>
    <nav class="main-nav">
      <ul>
        {%- for item_url, item_title in nav_items %}
        <li><a {% if page.url == item_url %}class="nav-active"{% endif %} href="{{ item_url }}">{{ item_title }}</a></li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="main-content">
      {{ content | safe }}
    </div>

    <div class="flex-stretch"></div>

    <footer class="main-footer justify-center">
      <a href="https://github.com/gilzoide/">{% include "GitHub-Mark.svg" %}</a>
      <a href="https://twitter.com/gilzoide">{% include "Twitter-Logo.svg" %}</a>
      <a href="https://www.linkedin.com/in/gilzoide/">{% include "LinkedIn-Logo.svg" %}</a>
      <div class="flex-break"></div>
      <p class="main-footer-copyright">Copyright ⓒ 2021 Gil Barbosa Reis</p>
    </footer>
  </body>
</html>
