---
title: Blog
layout: base
css:
  - "/css/cards.css"
---
{% from "article.njk" import article_header, article_meta %}
{%- macro article_card(p) -%}
<div class="justify-center card flex-column" href="{{ p.url }}">
    <a class="undecorated-link" href="{{ p.url }}">
      {{ article_header(p.data.title, p.data.subtitle) }}
    </a>
    {{ article_meta(p.date, p.data.tags, p.url) }}
    <a class="undecorated-link" href="{{ p.url }}">
      <p>{{ p.data.description or p.data.title }}</p>
    </a>
</div>
{%- endmacro -%}

<div class="justify-center flex-column">
{%- for a in collections.article | sort(true, false, 'date') -%}
  {%- if not a.data.ignore -%}
  {{ article_card(a) }}
  {%- endif %}
{%- endfor -%}
</div>
