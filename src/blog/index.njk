---
title: Blog
layout: base
css:
  - "/css/cards.css"
---
{%- macro article_card(p) %}
<div class="justify-center card flex-column" href="{{ p.url }}">
    <a class="undecorated-link" href="{{ p.url }}">
      <h2>
        {{ p.data.title }}
        {% if p.data.subtitle %}
          <br />
          <span class="subtitle">{{ p.data.subtitle }}</span>
        {% endif %}
      </h2>
    </a>
    <span class="card-meta">
      {{ p.date | datestr }}
      {% if p.data.tags.length > 1 %}
        &ensp; | &ensp;
        {% for tag in p.data.tags %}
          {%- if tag != "article" %}
        <a class="decorated-link">{{ tag }}</a>
          {% endif -%}
        {% endfor %}
      {% endif %}
    </span>
    <a class="undecorated-link" href="{{ p.url }}">
      <p>{{ p.data.description or p.data.title }}</p>
    </a>
</div>
{% endmacro -%}

<div class="justify-center flex-column">
{%- for a in collections.article %}
  {{ article_card(a) }}
{% endfor -%}
</div>
